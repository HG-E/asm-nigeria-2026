# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings > Database), used by
# local dev/admin scripts (scripts/*.mjs) -- not read by the deployed app.
DATABASE_URL=

# Supabase Management API personal access token (account settings, not
# project settings). Server-only, dev tooling use only (e.g. reading/writing
# Auth config like site_url/redirect URLs). NEVER expose to the browser.
SUPABASE_ACCESS_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free-tier SMTP credentials
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
